# Copy this file to the repository root as .env. The root .env is gitignored.
# Values are shell-compatible; do not commit the copied file.

# Optional local hub overrides. The defaults match Tiltfile.cluster. The
# bootstrap script verifies HTTPS by default and retries fresh hub startup.
# RAILGRID_BOOTSTRAP_HUB_URL=https://localhost:9443
# RAILGRID_BOOTSTRAP_STATIC_TOKEN=dev-token
# RAILGRID_BOOTSTRAP_KUBECONFIG=.kcp/dev-tenant.kubeconfig
# RAILGRID_BOOTSTRAP_RETRIES=30
# RAILGRID_BOOTSTRAP_RETRY_DELAY_SECONDS=2
# RAILGRID_BOOTSTRAP_REQUEST_TIMEOUT_SECONDS=10
# RAILGRID_BOOTSTRAP_BINDING_RETRIES=30

# For a local self-signed Tilt certificate, choose exactly one option. The
# insecure option is accepted only for localhost/loopback hub URLs. Prefer a
# trusted CA file when one is available; remote HTTPS hosts are never allowed
# to use the insecure option.
# RAILGRID_BOOTSTRAP_CA_CERT=/absolute/path/to/local-ca.pem
# RAILGRID_BOOTSTRAP_INSECURE_TLS=true

# provider-code / GitHub
RAILGRID_BOOTSTRAP_GITHUB_OWNER=your-github-user-or-org
RAILGRID_BOOTSTRAP_GITHUB_TOKEN=github_pat_replace_me
RAILGRID_BOOTSTRAP_GITHUB_CONNECTION_NAME=github

# App Studio's tenant LLM Secret. These defaults target an OpenAI-compatible
# endpoint; change all three settings for another compatible service.
RAILGRID_BOOTSTRAP_LLM_PROVIDER=openai-compatible
RAILGRID_BOOTSTRAP_LLM_BASE_URL=https://api.openai.com/v1
RAILGRID_BOOTSTRAP_LLM_MODEL=gpt-5.4
RAILGRID_BOOTSTRAP_LLM_API_KEY=replace_me

# Databricks
# Optional: install and enable the external Databricks provider first.
RAILGRID_BOOTSTRAP_DATABRICKS_HOST=
RAILGRID_BOOTSTRAP_DATABRICKS_TOKEN=dapi_replace_me
RAILGRID_BOOTSTRAP_DATABRICKS_CONNECTION_NAME=databricks

# Opt-in Config Connector + GCP Pub/Sub smoke workflow. These values are
# intentionally dev-neutral: use a disposable project and an absolute path to
# a local service-account key. The key file is imported into the runtime
# cluster by the manual Tilt action; never paste JSON into this file.
RAILGRID_CONFIG_CONNECTOR_GCP_PROJECT=railgrid-dev-kcc
RAILGRID_CONFIG_CONNECTOR_GCP_CREDENTIALS_FILE=/absolute/path/to/railgrid-kcc-service-account.json
# Legacy RAILGRID_E2E_GCP_PROJECT / RAILGRID_E2E_GCP_CREDENTIALS_FILE variables are
# still accepted when invoking the Make targets directly.

# Before running this setup resource, register and initialize the Code and
# Databricks providers, then enable both providers in the active tenant
# workspace. The script waits for their APIBindings to reach Bound before it
# creates either Connection object.
