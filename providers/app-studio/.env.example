# Local-dev environment for the railgrid "app-studio" provider.
#
# Copy to providers/app-studio/.env only when you need to override defaults.
# `make run-provider-app-studio` and both Tiltfiles auto-source the gitignored
# .env file, so no manual `export` is needed.
#
# By default, local dev starts a Postgres container named
# railgrid-app-studio-postgres and points App Studio at it. Conversation history
# survives provider restarts and hard refreshes because it uses the same
# Postgres-backed store path as production.
#
# Use an existing Postgres instead of the local dev container.
# APP_STUDIO_DATABASE_URL=postgres://appstudio:appstudio@localhost:55432/appstudio?sslmode=disable
#
# Optional Provider Actions origin for action-enabled development runtimes.
# Set this only to an absolute HTTPS origin reachable from sandbox pods and
# trusted by their system CA. The launcher intentionally supplies no
# localhost/http default; leave it unset when Projects have no action grants.
# RAILGRID_ACTIONS_EXTERNAL_URL=https://hub.example.test
# Optional public CA bundle for a private/self-signed action origin. Prefer a
# file path; the launcher reads it only when a Project has an active action
# grant. RAILGRID_ACTIONS_CA_BUNDLE may be used for a direct PEM value instead;
# if both are set they must match.
# RAILGRID_ACTIONS_CA_BUNDLE_FILE=.kcp/railgrid-hub-ca.pem
# RAILGRID_ACTIONS_CA_BUNDLE=
#
# Force old non-durable behavior for one-off UI work.
# APP_STUDIO_IN_MEMORY_MESSAGE_STORE=true
#
# Optional message-store controls.
# APP_STUDIO_MESSAGE_RETENTION=720h
# APP_STUDIO_MESSAGE_ENCRYPTION_KEYS=primary:<base64-32-byte-aes-key>
#
# Project workspace files used by App Studio local file tools.
# APP_STUDIO_WORKSPACE_ROOT=.kcp/app-studio-workspaces
#
# Local preview Gateways commonly use a self-signed certificate. Keep this
# preview-only; RAILGRID_HUB_INSECURE and the MCP TLS override do not affect
# external preview certificate verification.
# APP_STUDIO_PREVIEW_INSECURE_SKIP_TLS_VERIFY=true

# Preview inspection drives the workspace's shared headless browser (the
# infrastructure provider's Playwright MCP "browser" template, provisioned once
# per workspace by the Studio reconciler) over the infrastructure data plane.
# There is no browser worker URL to configure.

# Signed DOM annotation sharing starts automatically while the embedded preview
# is open. Tilt and
# `make run-provider-app-studio` automatically generate and reuse a local P-256
# key under `.kcp/app-studio-preview-bridge/`; the Infrastructure provider gets
# the matching public JWKS. The local Make/Tilt flow deliberately owns the
# complete tuple so one-sided overrides cannot create mismatched keys. Custom
# launches and Helm deployments may set the signing variables directly. With
# no signing material, App Studio remains available and reports the optional
# preview bridge as unavailable. Set the flag to false for a deployment-wide
# kill switch.
# APP_STUDIO_PREVIEW_BRIDGE_ENABLED=true
#
# Per-run model-call ceiling. Defaults to 200; only an explicit 0 or
# "unlimited" removes it (the provider logs that it runs unbounded).
APP_STUDIO_ASSISTANT_MAX_ITERATIONS=
# Per-run weighted-token budget. Defaults to 2000000; only an explicit 0 or
# "unlimited" disables it (logged).
APP_STUDIO_ASSISTANT_ROLLOUT_BUDGET_TOKENS=
# Per-organization monthly model spend cap in USD, checked before every model
# call across all projects and runs. Defaults to 100; only an explicit 0 or
# "unlimited" disables it (logged).
APP_STUDIO_ORG_MONTHLY_USD_CAP=
# Active model context window used for Codex-style token-pressure compaction.
# Defaults to 128000 when the provider does not expose model metadata.
APP_STUDIO_ASSISTANT_MODEL_CONTEXT_TOKENS=
