# The base is an explicit build input so operators can pin it by digest. The
# resulting image is also selected at runtime by RAILGRID_DEV_IMAGE_UNIVERSAL;
# both controls are intentional because this image executes tenant source.
ARG BASE_IMAGE=docker.io/library/node:22-bookworm
FROM ${BASE_IMAGE}

USER root

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        bash \
        ca-certificates \
        curl \
        git \
        golang-go \
        jq \
        make \
        python3 \
        python3-venv \
        ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && install -d -o 1000 -g 1000 /workspace /tmp/railgrid-home /tmp/railgrid-cache

# The node Debian base already supplies uid/gid 1000. Keep the image usable
# with the overlay's pod-level runAsNonRoot boundary without relying on that
# image's named user surviving a downstream rebuild.
USER 1000:1000
WORKDIR /workspace
ENV HOME=/tmp/railgrid-home \
    TMPDIR=/tmp \
    XDG_CACHE_HOME=/tmp/railgrid-cache \
    NPM_CONFIG_CACHE=/tmp/railgrid-cache/npm

CMD ["sleep", "infinity"]
